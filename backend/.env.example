# Angel One SmartAPI credentials
# Get these from https://smartapi.angelbroking.com/ (create an app to get the API key)
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_CODE=your_client_code_here
# This is your Angel One login PIN/MPIN, not your trading password
ANGEL_PASSWORD=your_pin_here
# Secret shown when you enable TOTP (Google Authenticator) for API login
ANGEL_TOTP_SECRET=your_totp_secret_here

# Frontend origin allowed to call this API (comma separated for multiple)
CORS_ORIGINS=http://localhost:5173
